{
  "name": "@repalis/i18n",
  "version": "0.1.0",
  "description": "Repalis i18n - Locale files and translation utilities",
  "author": "Repalis",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/repaliscom/Repalis.git",
    "directory": "clients/packages/i18n"
  },
  "scripts": {
    "translate": "tsx scripts/translate.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formatters/date": {
      "types": "./dist/formatters/date.d.ts",
      "default": "./dist/formatters/date.js"
    },
    "./formatters/ordinal": {
      "types": "./dist/formatters/ordinal.d.ts",
      "default": "./dist/formatters/ordinal.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@repalis/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@typescript/native": "catalog:",
    "dotenv": "^16.6.1",
    "react": "^19.3.0",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
