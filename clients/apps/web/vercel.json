{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && turbo run build --filter=web",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "https://repalis.com/docs",
      "has": [{ "type": "host", "value": "sandbox.repalis.com" }],
      "permanent": true
    },
    {
      "source": "/docs/:path+",
      "destination": "https://repalis.com/docs/:path+",
      "has": [{ "type": "host", "value": "sandbox.repalis.com" }],
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/_mintlify/api/:path+",
      "destination": "https://repalis.mintlify.site/_mintlify/api/:path+"
    },
    {
      "source": "/api/request",
      "destination": "https://repalis.mintlify.site/_mintlify/api/request"
    },
    {
      "source": "/docs",
      "destination": "https://repalis.mintlify.site/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://repalis.mintlify.site/docs/:path*"
    },
    {
      "source": "/mintlify-assets/:path+",
      "destination": "https://repalis.mintlify.site/mintlify-assets/:path+"
    },
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://us-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://us.i.posthog.com/$1"
    }
  ],
  "trailingSlash": false
}
