{
  "name": "@repalis/adapter-utils",
  "version": "1.1.1",
  "description": "Core package for Polar adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/repaliscom/Repalis.git",
    "directory": "clients/adapters/adapter-utils"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@repalis/sdk": "1.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repalis/typescript-config": "workspace:*",
    "@typescript/native": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
