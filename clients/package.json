{
  "private": true,
  "name": "repalis",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev",
    "dev-web": "turbo run dev --filter=web",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "pnpm -C packages/client generate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "box-codemod": "pnpm --filter @repalis/box-codemod box-codemod",
    "preinstall": "npx only-allow pnpm",
    "prepare": "([ -f \"packages/cli/node_modules/.bin/effect-tsgo\" ] && pnpm --filter @repalis/cli exec effect-tsgo patch || true) && ([ -n \"$VERCEL\" ] || [ -n \"$DOCKER\" ] || turbo run build --filter='./packages/*')",
    "release-packages": "turbo run build test --filter='./packages/*' --filter='./adapters/*' --filter='!@repalis/cli' && turbo run lint --filter='!@repalis/cli' && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@manypkg/cli": "^0.25.1",
    "esbuild": "^0.28.2",
    "knip": "^5.88.1",
    "only-allow": "1.2.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "turbo": "^2.11.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.8.0",
  "manypkg": {
    "ignoredRules": [
      "INTERNAL_MISMATCH"
    ]
  }
}
