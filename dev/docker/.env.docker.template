# Docker Development Environment Configuration
# This file is automatically copied to .env.docker when running docker-dev
#
# All variables have sensible defaults. Only uncomment and modify
# values if you need to customize the development environment.

# Instance number for port isolation (0 = default ports, no offset)
# Set via: dev docker set-instance <number>
# REPALIS_DOCKER_INSTANCE=

# Database credentials (defaults work out of the box)
# REPALIS_POSTGRES_USER=repalis
# REPALIS_POSTGRES_PWD=repalis
# REPALIS_POSTGRES_DATABASE=repalis
# REPALIS_POSTGRES_READ_USER=repalis_read
# REPALIS_POSTGRES_READ_PWD=repalis

# MinIO credentials (defaults work out of the box)
# REPALIS_MINIO_USER=repalis
# REPALIS_MINIO_PWD=repalisrepalis
# REPALIS_AWS_ACCESS_KEY_ID=repalis-development
# REPALIS_AWS_SECRET_ACCESS_KEY=repalis123456789
# REPALIS_S3_FILES_BUCKET_NAME=repalis-s3
# REPALIS_S3_FILES_PUBLIC_BUCKET_NAME=repalis-s3-public

# Optional: GitHub integration (for full OAuth features)
# REPALIS_GITHUB_CLIENT_ID=
# REPALIS_GITHUB_CLIENT_SECRET=
# REPALIS_GITHUB_APP_NAMESPACE=

# Optional: Stripe integration (for payment features)
# REPALIS_STRIPE_SECRET_KEY=
# REPALIS_STRIPE_PUBLISHABLE_KEY=
# REPALIS_STRIPE_WEBHOOK_SECRET=
# REPALIS_STRIPE_CONNECT_WEBHOOK_SECRET=
# REPALIS_STRIPE_ACCOUNT_RISK_WEBHOOK_SECRET=

# Optional: Prometheus remote write URL
# REPALIS_PROMETHEUS_REMOTE_WRITE_URL=
